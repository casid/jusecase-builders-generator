<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd ">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jusecase</groupId>
        <artifactId>builders-generator-parent</artifactId>
        <version>2.0.0</version>
    </parent>

    <artifactId>builders-generator-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>JUsecase Builders Generator Maven Plugin</name>
    <description>Maven plugin that generates builders for descriptive unit test setups.</description>

    <dependencies>
        <dependency>
            <groupId>org.jusecase</groupId>
            <artifactId>builders-generator-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>3.9.12</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>3.9.12</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>3.15.2</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.15.2</version>
                <executions>
                    <execution>
                        <id>mojo-descriptor</id>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <goalPrefix>builders-generator</goalPrefix>
                    <mojoDependencies>
                        <param>org.jusecase:builders-generator-maven-plugin</param>
                    </mojoDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
